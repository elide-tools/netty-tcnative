# GNU Makefile for the static-archive build of netty-tcnative.
# Hand-rolled (mirrors transport-native-kqueue/Makefile.static pattern) so the
# static-JNI build can run under different CFLAGS than libtool's shared build.
#
# Inputs (set by the antrun execution that invokes this Makefile):
#   CC             - compiler; default clang
#   AR             - archiver; default llvm-ar
#   RANLIB         - ranlib; default llvm-ranlib
#   JNI_PLATFORM   - "darwin" | "linux"
#   LIB_DIR        - output directory for the .a
#   OBJ_DIR        - intermediate .o dir; defaults to $(LIB_DIR)/obj
#   LIB_NAME       - basename of the lib (e.g. libnetty_tcnative)
#   SRC_DIR        - directory containing the tcnative .c sources and headers
#                    (the copy-src target dir; same path for openssl-dynamic and
#                    the static-flavor reactor builds)
#   SSL_INCLUDE_DIR - OpenSSL/BoringSSL/LibreSSL include dir
#   APR_INCLUDE_DIR - APR include dir
#   APR_STATIC_LIB - optional path to libapr-1.a; when set, its .o files are
#                    extracted and embedded into the output archive so APR
#                    symbols are self-contained for downstream Static-JNI use.
#   EXTRA_CFLAGS   - additional CFLAGS appended last
#
# Output: a static archive at $(LIB_DIR)/$(LIB_NAME).a containing tcnative's own
# .o files; embeds libapr-1.a's .o when APR_STATIC_LIB is set. Does NOT embed
# libssl.a / libcrypto.a / libdecrepit.a (BoringSSL) / libtls.a (LibreSSL) —
# those are still left to downstream linkers.

CC        ?= clang
LTO_FLAGS ?= -flto=thin
ifeq ($(JNI_PLATFORM),darwin)
AR        ?= ar
RANLIB    ?= ranlib
else
AR        ?= llvm-ar
RANLIB    ?= llvm-ranlib
endif
OBJ_DIR   ?= $(LIB_DIR)/obj

JNI_INCLUDE_DIR = $(JAVA_HOME)/include
JNI_INCLUDES    = -I$(JNI_INCLUDE_DIR) -I$(JNI_INCLUDE_DIR)/$(JNI_PLATFORM)

LIB = $(LIB_DIR)/$(LIB_NAME).a

# Optional include dirs — empty if not provided.
SSL_INCLUDE_FLAG = $(if $(SSL_INCLUDE_DIR),-I$(SSL_INCLUDE_DIR),)
APR_INCLUDE_FLAG = $(if $(APR_INCLUDE_DIR),-I$(APR_INCLUDE_DIR),)

CFLAGS := $(JNI_INCLUDES) \
          -I$(SRC_DIR) \
          $(SSL_INCLUDE_FLAG) \
          $(APR_INCLUDE_FLAG) \
          -DNETTY_BUILD_STATIC \
          -DTCN_BUILD_STATIC \
          -DHAVE_OPENSSL \
          -fPIC \
          -fvisibility=hidden \
          $(LTO_FLAGS) \
          -O3 \
          -Wall \
          -Wno-attributes \
          -Wno-deprecated-declarations \
          $(EXTRA_CFLAGS) $(USER_CFLAGS)

SRCS = $(wildcard $(SRC_DIR)/*.c)
OBJS = $(SRCS:$(SRC_DIR)/%.c=$(OBJ_DIR)/%.o)

all: $(LIB)

# When APR_STATIC_LIB is set, extract its .o files into $(OBJ_DIR)/apr/ and
# include them in the final archive so APR symbols are self-contained.
ifneq ($(strip $(APR_STATIC_LIB)),)
$(LIB): $(OBJS) | $(OBJ_DIR)/apr
	mkdir -p $(LIB_DIR)
	cd $(OBJ_DIR)/apr && $(AR) x $(APR_STATIC_LIB)
	$(AR) rcs $@ $(OBJS) $(OBJ_DIR)/apr/*.o
	$(RANLIB) $@

$(OBJ_DIR)/apr:
	mkdir -p $@
else
$(LIB): $(OBJS)
	mkdir -p $(LIB_DIR)
	$(AR) rcs $@ $(OBJS)
	$(RANLIB) $@
endif

$(OBJ_DIR)/%.o: $(SRC_DIR)/%.c
	mkdir -p $(OBJ_DIR)
	$(CC) -o $@ -c $< $(CFLAGS)

clean:
	rm -rf $(LIB_DIR) $(OBJ_DIR)

.PHONY: all clean
